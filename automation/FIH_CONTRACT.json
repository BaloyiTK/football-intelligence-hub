{
  "schema": "fih-execution-contract-v1",
  "contractVersion": "2.9.1",
  "authority": "canonical-machine-readable",
  "mutationPolicy": {
    "runtimeRuleCreation": "forbidden",
    "ruleInterpretationOverride": "forbidden",
    "ruleRelaxation": "forbidden",
    "ruleSubstitution": "forbidden",
    "ruleChangesRequire": "explicit-user-approval-outside-execution"
  },
  "production": {
    "modelVersion": "v2.9-market-specific-quality-selector",
    "modelPath": "lib/model.ts",
    "timezone": "Africa/Johannesburg",
    "status": "locked",
    "lockedBaseline": "v2.9",
    "lockedOn": "2026-10-05",
    "futureRuleChangesRequireNewModelVersion": true,
    "oddsRole": "analysis-and-roi-only-not-publication-gate",
    "validationBenchmark": {
      "train": {
        "start": "2026-04-08",
        "end": "2026-08-05",
        "bets": 374,
        "wins": 313,
        "losses": 61,
        "hitRate": 83.7
      },
      "holdout": {
        "start": "2026-08-06",
        "end": "2026-10-04",
        "bets": 310,
        "wins": 251,
        "losses": 59,
        "hitRate": 81
      },
      "combined": {
        "bets": 684,
        "wins": 564,
        "losses": 120,
        "hitRate": 82.5
      }
    }
  },
  "pipeline": [
    "load-contract",
    "freeze-contract-hash",
    "preflight",
    "resolve-run-and-resume",
    "reconcile-results",
    "freeze-registry",
    "worldwide-discovery",
    "normalize-and-map",
    "persist-discovery",
    "verify-prematch",
    "research",
    "calculate-primary-and-support-signals",
    "calibrate-risk-and-select-one-or-no-bet",
    "freeze-output",
    "complete-all-checkpoints",
    "validate",
    "finalize",
    "publish-daily-artifact",
    "verify-publication-artifact",
    "train-if-new-verified-outcomes",
    "verify-exact-deployment-sha"
  ],
  "discovery": {
    "minimumIndependentGlobalDateSources": 2,
    "worldwideSenior": true,
    "registryIsCoverageFloorNotCeiling": true
  },
  "research": {
    "hierarchy": [
      "full",
      "standard",
      "basic",
      "no-model"
    ],
    "missingData": "null-or-unknown-never-invented",
    "historicalBacktest": {
      "repositoryDataRole": "optional-accelerator-only",
      "webReconstructionRequired": true,
      "noModelAllowedOnlyAfterWebHierarchyAttempt": true,
      "missingRepositoryInputsNeverBlock": true
    }
  },
  "markets": {
    "requiredFamilies": [
      "1X2",
      "Total Goals",
      "Double Chance"
    ],
    "actionable": {
      "1X2": [
        "Home",
        "Draw",
        "Away"
      ],
      "Total Goals": [
        "Over 1.5"
      ],
      "Double Chance": [
        "1X",
        "X2"
      ]
    },
    "supportingSignals": {
      "Over 1.5": {
        "requires": "Over 2.5",
        "rawMinimum": 68
      },
      "1X": {
        "requires": "1X2 Home",
        "rawMinimum": 62
      },
      "X2": {
        "requires": "1X2 Away",
        "rawMinimum": 66
      }
    },
    "forbidden": [
      "BTTS",
      "Team Goals",
      "Correct Score",
      "Asian Handicap",
      "Draw No Bet",
      "Corners",
      "Cards",
      "Half Time",
      "Player Props",
      "Win to Nil",
      "Double Chance 12"
    ],
    "maximumRecommendedBetsPerFixture": 1
  },
  "recommendation": {
    "minimumAdjustedProbability": 68,
    "ratings": {
      "Elite": 85,
      "Strong": 78,
      "Good": 68
    },
    "rawMinimums": {
      "Home": 62,
      "Draw": 62,
      "Away": 62,
      "Over 1.5": 72,
      "1X": 72,
      "X2": 76
    },
    "calibration": {
      "method": "shrink-toward-50",
      "confidenceShrink": {
        "high": 1,
        "medium": 0.95,
        "low": 0.9
      },
      "competitionShrink": {
        "club": 1,
        "international": 0.96,
        "friendly": 0.92
      },
      "marketDivergenceWatch": 20,
      "marketDivergenceReview": 30
    },
    "lambdaRisk": {
      "high": 3,
      "low": 0.25,
      "totalHigh": 4.8,
      "action": "REVIEW"
    },
    "selectionProbabilityMinimums": {
      "Home": 68,
      "Draw": 68,
      "Away": 68,
      "Over 1.5": 68,
      "1X": 68,
      "X2": 72
    },
    "marketTemperature": {
      "1X": 1.025,
      "X2": 1.55,
      "Over 1.5": 1.025
    },
    "publishProbabilityMinByPick": {
      "1X": 82,
      "Over 1.5": 78,
      "X2": 78,
      "Home": 78,
      "Draw": 78,
      "Away": 78
    },
    "minimumSupportMarginByPick": {
      "1X": 5,
      "Over 1.5": 7,
      "X2": 5,
      "Home": 5,
      "Draw": 5,
      "Away": 5
    }
  },
  "invariants": {
    "exactProductionModelRequired": true,
    "preKickoffFreezeRequired": true,
    "duplicateFixtureIdentityForbidden": true,
    "allRegistryCheckpointsRequired": true,
    "noBetAndNoModelAreNotPerformanceResults": true,
    "historicalResultVisibleOnlyAfterFreeze": true,
    "supportGateRequiredForSaferMarkets": true,
    "extremeLambdaMustNotAutoPublish": true,
    "extremeMarketDivergenceMustNotAutoPublish": true,
    "reviewBetIsNotPublicRecommendation": true,
    "backtestMayNotStopForMissingStoredInputs": true,
    "fixtureLocalFailureMustNotStopRun": true,
    "historicalBacktestMustReconstructPrematchEvidenceFromWeb": true,
    "repositoryHistoricalInputsAreNeverRequired": true,
    "marketSpecificPublicationGateRequired": true,
    "publicProbabilityMustUseMarketSpecificCalibration": true,
    "lockedV29BusinessRulesImmutable": true,
    "oddsMustNotGateV29Publication": true,
    "resultReconciliationRequiredBeforeNewDailyRun": true,
    "resultReconciliationMustNotMutateFrozenPrediction": true,
    "pendingHistoricalResultsMustNotBlockCurrentDailyRun": true,
    "publishableFixtureMetadataRequired": true,
    "publishableFixtureMetadataFields": [
      "date",
      "country",
      "leagueId",
      "league",
      "homeTeam",
      "awayTeam",
      "kickoff"
    ],
    "missingKickoffBlocksPublication": true
  },
  "selfCorrection": {
    "mayChangeExecutionPath": true,
    "mayRepairInvalidState": true,
    "mayChangeBusinessRules": false,
    "mayInventFallbackRule": false
  },
  "specGap": {
    "state": "SPEC_GAP",
    "action": "do-not-invent-rule; preserve safe progress; require explicit user-approved contract change if unresolved"
  },
  "completion": {
    "strictFinalizerRequired": true,
    "publicationVerificationRequiredForDailyArtifact": true,
    "deploymentIsSeparateFromModelCompletion": true,
    "backtestMustContinueUntilAllCheckpointsTerminal": true,
    "fixtureLevelFailureAction": "NO_MODEL_AND_CONTINUE",
    "progressResponseIsNeverExecutionBoundary": true,
    "allowedEarlyStopReasons": [
      "would-require-fabrication",
      "future-leakage",
      "unsafe-mutation"
    ]
  },
  "reconciliation": {
    "required": true,
    "command": "npm run results:reconcile -- YYYY-MM-DD <verified-results.json>",
    "verifiedFinalScoreRequired": true,
    "minimumResultSources": 1,
    "gradeOriginalPublishedRecommendation": true,
    "mayAppend": [
      "fixture.result",
      "daily.results"
    ],
    "mayMutateFrozenPredictionFields": false,
    "failureBlocksCompletion": true,
    "attemptRequiredBeforeNewDailyRun": true,
    "unresolvedResultAction": "persist-pending-with-attempted-sources-and-verification-timestamp",
    "pendingResultsDoNotBlockNewDailyRun": true,
    "revisitPendingResultsOnFutureRuns": true,
    "completionGate": "previous-published-day-reconciled-or-verified-pending",
    "requirePreviousPublishedDayBeforeDailyCompletion": true,
    "requiredTerminalStates": [
      "graded",
      "verified-pending"
    ],
    "gradedResultRequires": [
      "verified-final-score",
      "WIN-LOSS-VOID-grade",
      "daily-results-aggregate"
    ],
    "verifiedPendingRequires": [
      "verification-attempt",
      "attempted-sources",
      "verification-timestamp",
      "pending-reason"
    ]
  },
  "recoveryPolicy": {
    "enabled": true,
    "mode": "fail-safe-auto-recovery",
    "preserveCheckpoints": true,
    "resumeLatestNonCompleteRunFirst": true,
    "resumeFromExactCursorAndResumeAction": true,
    "fixtureLocalFailureMustNotStopIndependentWork": true,
    "autoRepairExecutionPath": true,
    "businessRuleMutationForbidden": true,
    "evidenceFabricationForbidden": true,
    "unresolvedResearchMayNotBeConvertedToNoModelForFinalization": true,
    "transientRetry": {
      "enabled": true,
      "maxAttempts": 3,
      "backoffSeconds": [
        15,
        45,
        120
      ],
      "retryableClasses": [
        "network",
        "github-api",
        "runner",
        "dependency-install",
        "deployment-status",
        "temporary-source-unavailability"
      ]
    },
    "validationRecovery": {
      "rereadControllingRule": true,
      "preserveValidFrozenState": true,
      "repairOnlyInvalidState": true,
      "rerunValidationAfterRepair": true,
      "strictFinalizerStillRequired": true
    },
    "blockerPolicy": {
      "fixtureLocal": "persist-attempted-sources-unresolved-fact-stage-canonical-identity-resumeAction-and-continue",
      "runLevel": "only-genuine-global-external-or-technical-dependency-after-approved-fallbacks-exhausted",
      "persistExactResumeCursor": true
    },
    "publication": {
      "neverPublishIncompleteAsFinal": true,
      "partialFrozenBetsMayBeSurfacedAsPartial": true,
      "exactDeploymentVerificationRequired": true,
      "writeRecoveryOrder": [
        "retry-primary-repository-write",
        "refetch-target-and-head-state",
        "retry-with-current-sha-or-create-file-as-applicable",
        "use-alternate-approved-github-write-path",
        "verify-artifact-content-and-count",
        "commit-to-main",
        "verify-exact-deployment-sha"
      ]
    },
    "completionController": {
      "enabled": true,
      "successRequires": [
        "previous-published-day-reconciled-or-verified-pending",
        "strict-finalization",
        "daily-artifact-written",
        "publication-verified",
        "publication-commit-on-main",
        "exact-deployment-sha-verified"
      ],
      "stopAfterValidationForbidden": true,
      "stopAfterFinalizationForbidden": true,
      "publicationWriteFailureIsRecoverable": true,
      "alternateRepositoryWritePathRequired": true,
      "retryFromFailedStageNotFromStart": true,
      "neverDisableScheduledAutomationForRecoverableFailure": true,
      "scheduledNextRunMustResumeUnfinishedPriorPublicationBeforeStartingDuplicate": true,
      "finalResponseMayClaimCompleteOnlyAfterAllSuccessRequirementsPass": true
    },
    "maxAutomaticRepairCyclesPerStage": 3,
    "errorClassification": [
      "syntax-config",
      "schema-migration",
      "transient-infrastructure",
      "validation-state",
      "fixture-local-data",
      "publication-write",
      "global-integrity"
    ],
    "schemaMigrationRecovery": {
      "enabled": true,
      "preserveLegacyCompetitionIds": true,
      "associationScopesAreDiscoveryLayer": true,
      "competitionIdsRemainExecutionIdentity": true,
      "automaticOnlyWhenDeterministic": true
    },
    "stageRecovery": {
      "diagnoseBeforeExit": true,
      "repairThenRerunFailedStage": true,
      "resumeFromCheckpoint": true,
      "doNotRestartCompletedStages": true,
      "continueIndependentFixtures": true
    },
    "escalateOnlyWhen": [
      "repair-would-change-business-rules",
      "repair-would-fabricate-evidence-or-result",
      "ambiguous-state-migration",
      "corrupted-or-contradictory-global-integrity",
      "approved-repair-budget-exhausted"
    ],
    "audit": {
      "persistRepairAttempts": true,
      "persistFailureClass": true,
      "persistResumeCursor": true,
      "persistRepairOutcome": true
    }
  }
}
