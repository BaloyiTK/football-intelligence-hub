{
  "schema": "fih-execution-contract-v1",
  "contractVersion": "2.9.0",
  "authority": "canonical-machine-readable",
  "mutationPolicy": {
    "runtimeRuleCreation": "forbidden",
    "ruleInterpretationOverride": "forbidden",
    "ruleRelaxation": "forbidden",
    "ruleSubstitution": "forbidden",
    "ruleChangesRequire": "explicit-user-approval-outside-execution"
  },
  "production": {
    "modelVersion": "v2.9-market-specific-quality-selector",
    "modelPath": "lib/model.ts",
    "timezone": "Africa/Johannesburg"
  },
  "pipeline": [
    "load-contract",
    "freeze-contract-hash",
    "preflight",
    "resolve-run-and-resume",
    "reconcile-results",
    "freeze-registry",
    "worldwide-discovery",
    "normalize-and-map",
    "persist-discovery",
    "verify-prematch",
    "research",
    "calculate-primary-and-support-signals",
    "calibrate-risk-and-select-one-or-no-bet",
    "freeze-output",
    "complete-all-checkpoints",
    "validate",
    "finalize",
    "publish-daily-artifact",
    "verify-publication-artifact",
    "train-if-new-verified-outcomes",
    "verify-exact-deployment-sha"
  ],
  "discovery": {
    "minimumIndependentGlobalDateSources": 2,
    "worldwideSenior": true,
    "registryIsCoverageFloorNotCeiling": true
  },
  "research": {
    "hierarchy": [
      "full",
      "standard",
      "basic",
      "no-model"
    ],
    "missingData": "null-or-unknown-never-invented",
    "historicalBacktest": {
      "repositoryDataRole": "optional-accelerator-only",
      "webReconstructionRequired": true,
      "noModelAllowedOnlyAfterWebHierarchyAttempt": true,
      "missingRepositoryInputsNeverBlock": true
    }
  },
  "markets": {
    "requiredFamilies": [
      "1X2",
      "Total Goals",
      "Double Chance"
    ],
    "actionable": {
      "1X2": [
        "Home",
        "Draw",
        "Away"
      ],
      "Total Goals": [
        "Over 1.5"
      ],
      "Double Chance": [
        "1X",
        "X2"
      ]
    },
    "supportingSignals": {
      "Over 1.5": {
        "requires": "Over 2.5",
        "rawMinimum": 68
      },
      "1X": {
        "requires": "1X2 Home",
        "rawMinimum": 62
      },
      "X2": {
        "requires": "1X2 Away",
        "rawMinimum": 66
      }
    },
    "forbidden": [
      "BTTS",
      "Team Goals",
      "Correct Score",
      "Asian Handicap",
      "Draw No Bet",
      "Corners",
      "Cards",
      "Half Time",
      "Player Props",
      "Win to Nil",
      "Double Chance 12"
    ],
    "maximumRecommendedBetsPerFixture": 1
  },
  "recommendation": {
    "minimumAdjustedProbability": 68,
    "ratings": {
      "Elite": 85,
      "Strong": 78,
      "Good": 68
    },
    "rawMinimums": {
      "Home": 62,
      "Draw": 62,
      "Away": 62,
      "Over 1.5": 72,
      "1X": 72,
      "X2": 76
    },
    "calibration": {
      "method": "shrink-toward-50",
      "confidenceShrink": {
        "high": 1,
        "medium": 0.95,
        "low": 0.9
      },
      "competitionShrink": {
        "club": 1,
        "international": 0.96,
        "friendly": 0.92
      },
      "marketDivergenceWatch": 20,
      "marketDivergenceReview": 30
    },
    "lambdaRisk": {
      "high": 3,
      "low": 0.25,
      "totalHigh": 4.8,
      "action": "REVIEW"
    },
    "selectionProbabilityMinimums": {
      "Home": 68,
      "Draw": 68,
      "Away": 68,
      "Over 1.5": 68,
      "1X": 68,
      "X2": 72
    },
    "marketTemperature": {
      "1X": 1.025,
      "X2": 1.55,
      "Over 1.5": 1.025
    },
    "publishProbabilityMinByPick": {
      "1X": 82,
      "Over 1.5": 78,
      "X2": 78,
      "Home": 78,
      "Draw": 78,
      "Away": 78
    },
    "minimumSupportMarginByPick": {
      "1X": 5,
      "Over 1.5": 7,
      "X2": 5,
      "Home": 5,
      "Draw": 5,
      "Away": 5
    }
  },
  "invariants": {
    "exactProductionModelRequired": true,
    "preKickoffFreezeRequired": true,
    "duplicateFixtureIdentityForbidden": true,
    "allRegistryCheckpointsRequired": true,
    "noBetAndNoModelAreNotPerformanceResults": true,
    "historicalResultVisibleOnlyAfterFreeze": true,
    "supportGateRequiredForSaferMarkets": true,
    "extremeLambdaMustNotAutoPublish": true,
    "extremeMarketDivergenceMustNotAutoPublish": true,
    "reviewBetIsNotPublicRecommendation": true,
    "backtestMayNotStopForMissingStoredInputs": true,
    "fixtureLocalFailureMustNotStopRun": true,
    "historicalBacktestMustReconstructPrematchEvidenceFromWeb": true,
    "repositoryHistoricalInputsAreNeverRequired": true,
    "marketSpecificPublicationGateRequired": true,
    "publicProbabilityMustUseMarketSpecificCalibration": true
  },
  "selfCorrection": {
    "mayChangeExecutionPath": true,
    "mayRepairInvalidState": true,
    "mayChangeBusinessRules": false,
    "mayInventFallbackRule": false
  },
  "specGap": {
    "state": "SPEC_GAP",
    "action": "do-not-invent-rule; preserve safe progress; require explicit user-approved contract change if unresolved"
  },
  "completion": {
    "strictFinalizerRequired": true,
    "publicationVerificationRequiredForDailyArtifact": true,
    "deploymentIsSeparateFromModelCompletion": true,
    "backtestMustContinueUntilAllCheckpointsTerminal": true,
    "fixtureLevelFailureAction": "NO_MODEL_AND_CONTINUE",
    "progressResponseIsNeverExecutionBoundary": true,
    "allowedEarlyStopReasons": [
      "would-require-fabrication",
      "future-leakage",
      "unsafe-mutation"
    ]
  }
}
